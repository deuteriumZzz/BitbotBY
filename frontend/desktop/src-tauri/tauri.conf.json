{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitbotBY",
  "version": "0.1.0",
  "identifier": "by.bitbot.desktop",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173/app/",
    "beforeDevCommand": "npm --prefix .. run dev",
    "beforeBuildCommand": "npm --prefix .. run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BitbotBY Terminal",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
