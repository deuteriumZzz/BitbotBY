.git
.gitignore
.env
__pycache__
*.pyc
*.pyo
.pytest_cache
backend/tests/
*.egg-info
build/
*.md
.claude/
models/
data/cache/
data/trades.db
logs/

# Фронтенд собирается в отдельной стадии Dockerfile; десктоп в образ не нужен
frontend/node_modules
frontend/dist
frontend/desktop/

# Лаунчер: мастер-ключ шифрования не должен попасть в слои образа
.launcher/
.server/

# Локальные окружения и кэши разработки — в образ не нужны (иначе контекст сборки ~3,5 ГБ)
.venv
.venv-*
**/.mypy_cache
**/.ruff_cache
**/node_modules
