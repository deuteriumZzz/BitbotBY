# ── Bybit API ──────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true → торговать на testnet (без реальных денег)
TESTNET=false

# Тип рынка:
# "spot"   — только лонги, не может шортить
# "linear" — perpetual futures, полный long+short (рекомендуется)
MARKET_TYPE=linear

# Плечо для фьючерсов (1=без плеча, рекомендуется 2-3x для старта)
LEVERAGE=3
# Режим управления плечом:
#   fixed      — всегда LEVERAGE (простой)
#   volatility — ATR-таргетинг: авто-подбор под волатильность [рекомендуется]
#   full       — ATR + режим рынка (up/sideways/down) + просадка
LEVERAGE_MODE=volatility
# Целевой риск портфеля на одно ATR-движение (0.01 = 1%); fallback = LEVERAGE
LEVERAGE_TARGET_RISK=0.01
LEVERAGE_MAX=5
LEVERAGE_MIN=1
# Порог просадки для режима плеча "full":
# при достижении этой просадки плечо снижается до 30% от расчётного.
# 0.10 = агрессивная защита, 0.15 = умеренная (рекомендуется), 0.20 = мягкая
# Не путать с MAX_DRAWDOWN_PERCENT (hard halt, ниже). Если не задан —
# берётся MAX_DRAWDOWN_PERCENT (старое поведение).
LEVERAGE_DD_THRESHOLD=0.15

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# Пароль Redis — рекомендуется задать в production (docker-compose передаст его
# в redis-server автоматически через --requirepass)
REDIS_PASSWORD=

# ── Ключи из приложения (MiniApp / Desktop) ─────────────────────────────────
# Мастер-ключ для шифрования ключей API, которые вводятся в приложении
# (файл data/secrets.enc.json). Без него хранилище ключей выключено.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеряете мастер-ключ — сохранённые ключи придётся ввести заново.
BITBOT_SECRETS_KEY=
# SECRETS_PATH=data/secrets.enc.json
# Адрес приложения для кнопки «Открыть терминал» в Telegram-боте и меню у поля
# ввода. Только https (требование Telegram), путь /app/ дашборда:
# WEBAPP_URL=https://bot.example.com/app/

# ── Dashboard auth ──────────────────────────────────────────────────────────
# После изменения запустить: make htpasswd
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# ── Trading ─────────────────────────────────────────────────────────────────
# Символ в формате ccxt spot: BTC/USDT, ETH/USDT, SOL/USDT и т.д.
TRADING_SYMBOL=BTC/USDT
# Таймфрейм ccxt: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=15m
INITIAL_BALANCE=10000.0
RISK_PER_TRADE=0.02
COMMISSION_RATE=0.001
# Интервал цикла в секундах (30 = режим реального времени)
TRADING_INTERVAL=30
MAX_POSITION_SIZE=0.1
STOP_LOSS_PERCENT=0.05

# ── AI-провайдеры ────────────────────────────────────────────────────────────
# Удобнее всего — в приложении: Настройки → AI. Там ключи, порядок цепочки,
# режим (Бесплатные / Смешанный / Платные) и выбор модели. Здесь — для запуска
# без приложения. Бот спрашивает провайдеров по цепочке: ошибка или лимит —
# сразу следующий. По умолчанию — только бесплатные модели.
# AI_PROVIDER: auto — по цепочке; имя провайдера (groq, gemini, …) — он первый.
AI_PROVIDER=auto

# Бесплатные. У каждого свой дневной лимит: чем больше ключей, тем реже бот
# остаётся без AI.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://openrouter.ai/keys — бесплатные модели с суффиксом «:free»
OPENROUTER_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Токен GitHub с правом models:read: https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=
# https://dash.cloudflare.com/profile/api-tokens + Account ID из панели Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Ollama Cloud: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# LLM7 работает и без ключа (включается в приложении); токен открывает больше моделей
LLM7_API_KEY=
# Своя Ollama на компьютере (включается в приложении):
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Платные
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# https://platform.openai.com
OPENAI_API_KEY=
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модели. Пусто — рекомендованная из каталога (src/ai_providers.py) или
# выбранная в приложении (она важнее всего). Модель, заданная здесь, важнее
# каталога — указывайте, только если уверены, что она есть у провайдера:
# GROQ_MODEL= GEMINI_MODEL= OPENROUTER_MODEL= NVIDIA_MODEL= DEEPSEEK_MODEL= OPENAI_MODEL= AI_MODEL=

# PumpPortal — БЕСПЛАТНЫЙ API для событий создания токенов на pump.fun
# Используется для эвристики meme-season (темп новых токенов/час).
# Получить ключ: https://pumpportal.fun/trading-api/setup → "Create Wallet & API Key"
# Депозит SOL НЕ нужен — только для чтения событий (subscribeNewToken бесплатен)
PUMPPORTAL_API_KEY=

# Лимит AI-вызовов в сутки (UTC) для анализа новостей; сверх → VADER-фолбек
# CLAUDE_DAILY_BUDGET принимается как алиас (обратная совместимость)
AI_DAILY_BUDGET=200

# ── Режим работы ─────────────────────────────────────────────────────────────
# local   → только правила (9 стратегий), без внешних API
# dqn     → только SAC-модель (обученная)
# ai      → AI-провайдер (по умолчанию)
# hybrid  → SAC + AI должны согласиться; расхождение → hold
MODE=ai
# SAC модель (создаётся: python reinforcement_learning/train_sac.py)
SAC_MODEL_PATH=models/sac_model.zip

# ── Market Scanner ──────────────────────────────────────────────────────────
# Сколько топ монет сканировать за итерацию (по объёму за 24ч)
SCAN_TOP_N=20
# Как открывать сделки в Live: true — автоматически (нашёл сигнал → сделка),
# false — с подтверждением в Telegram/приложении. В Paper бот не спрашивает никогда.
AUTO_EXECUTE=false
# Если AI/SAC недоступны (не ответил ни один AI-провайдер или модель SAC не загружена) —
# искать вход по локальным стратегиям. «Модель ответила, но входа нет» сюда не относится.
# false (по умолчанию): модель недоступна — новых сделок нет. В MODE=local не используется.
LOCAL_FALLBACK=false
# Если не ответили вовремя: execute — открыть сделку, skip — пропустить
CONFIRM_ON_TIMEOUT=execute

# ── Стратегии ───────────────────────────────────────────────────────────────
# Доступные стратегии:
#   ema_crossover   — EMA 12/26 кроссовер       (medium risk, trending)
#   rsi_momentum    — RSI перекупл./перепродан.  (medium risk, ranging)
#   macd_crossover  — MACD/Signal кроссовер      (medium risk, trending)
#   bollinger_bands — Полосы Боллинджера + RSI   (medium risk, volatile)
#   scalping        — Быстрые сделки <15m        (high risk,   volatile)
#   swing_trading   — Свинг на поворотах тренда  (medium risk, trending)
#   breakout        — Пробой уровней + объём     (high risk,   volatile)
#   mean_reversion  — Возврат к среднему         (medium risk, ranging)
#   trend_following — Следование тренду SMA50    (low risk,    trending)
ACTIVE_STRATEGY=ema_crossover

# Минимальный confidence сигнала для исполнения (0.0–1.0)
MIN_SIGNAL_CONFIDENCE=0.65
# Порог для paper режима — ниже для накопления большего числа сделок при обучении SAC
MIN_SIGNAL_CONFIDENCE_PAPER=0.60

# ── News API ─────────────────────────────────────────────────────────────────
# Ключ NewsAPI — получить на https://newsapi.org
NEWS_API_KEY=
# Интервал обновления новостей в секундах (900 = 15 мин)
NEWS_UPDATE_INTERVAL=900

# ── Twitter/X Sentiment ───────────────────────────────────────────────────────
# Bearer Token из Twitter Developer Portal.
# Тарифы: Free = только запись (READ недоступен), Basic = $100/мес (~10 000 твитов/мес).
# Получить: https://developer.twitter.com → Projects & Apps → Keys and tokens
# Если не задан — TwitterAnalyzer молча возвращает 0.0, бот работает без Twitter.
TWITTER_BEARER_TOKEN=
# Максимум твитов на один запрос (10 = экономит лимит Basic плана)
TWITTER_MAX_RESULTS=10

# ── Telegram Sentiment (Telethon MTProto) ─────────────────────────────────────
# Нужен для мониторинга публичных памп-каналов (профиль: мемкоины). Бесплатно.
# Получить API ID и Hash: https://my.telegram.org → API development tools
# Если не задан — TelegramSentiment молча возвращает 0.0, бот работает без него.
TELEGRAM_SENTIMENT_API_ID=
TELEGRAM_SENTIMENT_API_HASH=
# Номер телефона аккаунта Telegram для Telethon (формат: +375291234567)
# При первом запуске потребуется ввести код подтверждения (одноразово).
# Session сохраняется в data/tg_sentiment.session — повторная авторизация не нужна.
TELEGRAM_SENTIMENT_PHONE=
# Публичные каналы для мониторинга (через запятую, без @).
# Замените на реальные памп-группы вашего региона.
TELEGRAM_SENTIMENT_CHANNELS=CryptoMoonAlerts,pumpsignalscrypto,memecoinsnews

# ── Sentiment Poller ──────────────────────────────────────────────────────────
# Интервал опроса Twitter + Telegram в секундах (300 = каждые 5 мин).
# Активен только при профиле "meme". SentimentStrategy читает результаты из Redis.
SENTIMENT_POLL_INTERVAL=300
# TTL кэша сентимента в Redis в секундах (600 = 10 мин).
SENTIMENT_CACHE_TTL=600
# Пороги buy/sell для SentimentStrategy (диапазон -1.0..1.0).
# 0.4 = уверенный позитивный сигнал; -0.4 = уверенный негативный.
SENTIMENT_BUY_THRESHOLD=0.4
SENTIMENT_SELL_THRESHOLD=-0.4

# ── Telegram ──────────────────────────────────────────────────────────────
# Токен от BotFather (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (узнать: @userinfobot)
TELEGRAM_CHAT_ID=
# Время на решение по сделке, секунд: 10–120 (дольше — цена уходит, сигнал устаревает)
TELEGRAM_CONFIRM_TIMEOUT=60

# ── Risk Management ───────────────────────────────────────────────────────
# Максимальный дневной убыток: доля баланса (0.05 = 5%)
# При превышении → все позиции закрываются, торговля до UTC-дня
DAILY_LOSS_LIMIT=0.05

# ── Black swan / аварийные стоп-краны ─────────────────────────────────────
# Hard drawdown halt: просадка equity от пика (0.20 = 20%)
# Equity = баланс + unrealized PnL. При срабатывании: закрыть всё → пауза
MAX_DRAWDOWN_PERCENT=0.20
# Пауза в часах после срабатывания hard drawdown halt
DRAWDOWN_HALT_HOURS=4
# Flash-защита: подтверждений подряд перед срабатыванием (1 цикл ≈ 30с)
# 3 = ~90с устойчивой просадки. Flash crash не триггернёт.
# Меняется без перезапуска: Telegram → ⚖️ Риск-профиль → 🛡 Flash-защита ±
DRAWDOWN_CONFIRM_CYCLES=3
# ATR spike: если ATR в N× выше среднего → закрыть позиции, пауза 1ч
ATR_SPIKE_MULT=3.0
# Окно для расчёта среднего ATR (в свечах)
ATR_SPIKE_LOOKBACK=20

# ── Position Management ───────────────────────────────────────────────────
# Максимум одновременных позиций
MAX_POSITIONS=3
# true → бумажная торговля (нет реальных ордеров)
PAPER_TRADING=true
# Кодовое слово для переключения Paper ↔ Live через Telegram
# (оставить пустым — переключение по кнопке без PIN)
TRADING_MODE_PIN=

# ── Season Detector ───────────────────────────────────────────────────────────
# Режим реакции на смену сезона (только в LIVE режиме):
#   alert — уведомление в Telegram с кнопками Переключить / Оставить (рекомендуется)
#   auto  — профиль переключается автоматически без подтверждения
SEASON_SWITCH_MODE=alert
# Интервал проверки CoinGecko в часах (бесплатный API, ключи не нужны)
SEASON_CHECK_INTERVAL_H=4
# Trailing SL: двигать стоп вслед за ценой (множитель ATR)
TRAILING_STOP_ATR_MULT=1.0
# Circuit breaker: остановить бота после N подряд убыточных сделок (0 = выключен)
CIRCUIT_BREAKER_LOSSES=3

# ── Monitoring ────────────────────────────────────────────────────────────
# Порт HTTP health-сервера (GET /health → JSON, GET /metrics → Prometheus)
# 0 = выключен
HEALTH_PORT=8080
# API-ключ для дашборда (опционально). Если задан, все запросы кроме
# /health и /metrics требуют заголовок: X-API-Key: <значение>
DASHBOARD_API_KEY=
# Shared secret для вебхука Alertmanager (опционально). Если задан,
# Alertmanager должен слать заголовок X-Webhook-Secret: <значение>
ALERTMANAGER_WEBHOOK_SECRET=
# Максимальные часы молчания бота до "silent death" алерта
SILENT_DEATH_HOURS=6.0
# TTL кэша режима рынка в секундах
REGIME_CACHE_TTL=300

# ── Correlation filter ────────────────────────────────────────────────────
# Максимальная |корреляция| log-returns между одновременными позициями.
# Если новый сигнал коррелирует с любой открытой позицией сильнее порога —
# сигнал пропускается (защита от удвоенной экспозиции, напр. BTC + ETH лонг).
# 0.0 = фильтр выключен; рекомендовано 0.7
MAX_CORRELATION=0.7
# В paper режиме выше — крипто сильно коррелирует в боковике, 0.70 блокирует почти всё
MAX_CORRELATION_PAPER=0.85
# Окно расчёта корреляции в свечах (минимум 10)
CORRELATION_WINDOW=50

# ── Partial TP (улучшение 3) ─────────────────────────────────────────────
# true → закрывать часть позиции при достижении PARTIAL_TP_TRIGGER пути до TP
PARTIAL_TP_ENABLED=true
# Доля пути до TP для срабатывания (0.6 = 60%)
PARTIAL_TP_TRIGGER=0.6
# Доля позиции для закрытия (0.5 = 50%)
PARTIAL_TP_FRACTION=0.5

# ── Trading hours filter (улучшение 4) ───────────────────────────────────
# Торговые часы UTC. Пример: "8-22" = только с 8:00 до 22:00 UTC.
# Пустая строка = круглосуточно (по умолчанию).
TRADING_HOURS=

# ── Liquidity filter (улучшение 5) ───────────────────────────────────────
# Минимальный 24h объём в USDT для допуска к торговле
MIN_VOLUME_USDT=1000000
# Максимальный 24h объём в USDT (0 = без ограничения).
# Для профиля Альткоины: 2000000000 (отсекает BTC/ETH/SOL).
MAX_VOLUME_USDT=0
# Максимальный допустимый спред bid/ask в процентах (0.3 = 0.3%)
MAX_SPREAD_PCT=0.3
# Volume spike: во сколько раз объём свечи должен превысить среднее за 20 свечей.
# 2.5 = аномалия. Используется стратегией volume_spike. Диапазон: 2.0–4.0.
VOLUME_SPIKE_THRESHOLD=2.5

# ── Drawdown scaling (улучшение 6) ───────────────────────────────────────
# true → уменьшать размер позиции при просадке от пика баланса
DRAWDOWN_SCALE_ENABLED=true
# Порог просадки для активации (0.10 = 10% от пика)
DRAWDOWN_SCALE_THRESHOLD=0.10
# Множитель размера позиции при просадке (0.5 = уменьшить до 50%)
DRAWDOWN_SCALE_FACTOR=0.5

# ── Backtest ──────────────────────────────────────────────────────────────
# Доля данных для out-of-sample теста (0.2 = последние 20% данных)
BT_HOLDOUT_RATIO=0.2

# ── Macro blackout (улучшение 7) ─────────────────────────────────────────
# Ключ Finnhub API (бесплатный тир): https://finnhub.io
# Если не задан — фильтр отключается автоматически.
FINNHUB_API_KEY=
# true → блокировать открытие позиций за 30 мин до/после FOMC/CPI/NFP/GDP/PCE
MACRO_BLACKOUT_ENABLED=true

# ── Online Learning ────────────────────────────────────────────────────────
# Автообучение SAC-модели на реальных сделках.
#
# Режимы:
#   disabled — выключено, вручную: make train
#   online   — gradient steps после каждой сделки [⚠ РИСКОВАННО, только эксперименты]
#   periodic — полное переобучение в фоне каждые N сделок [✅ РЕКОМЕНДУЕТСЯ]
#   hybrid   — periodic + динамические веса стратегий в реальном времени
#              (рекомендуется после 200+ сделок)
#
# Путь перехода: накопить 100+ сделок → periodic → после 500+ сделок → hybrid
ONLINE_LEARNING_MODE=periodic

# Количество закрытых сделок до запуска переобучения (для periodic/hybrid)
ONLINE_LEARNING_TRIGGER=50

# Шагов градиента за один online-апдейт (только для режима online, ≤ 50)
ONLINE_LEARNING_GRADIENT_STEPS=50

# ── SAC Training ──────────────────────────────────────────────────────────
TRAIN_TOP_N=20
TRAIN_MIN_CANDLES=2880
TOTAL_TIMESTEPS=50000

# Пути к данным разделены по профилям — каждый профиль хранит свои данные отдельно.
# SAC_PROFILE выставляется автоматически при смене профиля через Telegram.
# Задавать вручную не нужно — бот управляет этим сам.
#
# Итоговые пути при активном профиле:
#   bluechip → data/experiences_bluechip.jsonl, models/best_hyperparams_bluechip.json
#   altcoin  → data/experiences_altcoin.jsonl,  models/best_hyperparams_altcoin.json
SAC_PROFILE=

# Используется только если SAC_PROFILE не задан (legacy / ручной запуск).
EXPERIENCES_PATH=data/experiences.jsonl
EXPERIENCES_MAX=10000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
JSON_LOGS=false
